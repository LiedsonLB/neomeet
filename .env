# Copie para ".env" (mesma pasta do docker-compose.yml). Este arquivo é só
# para as variáveis que o PRÓPRIO docker-compose usa (substituição de
# ${...}) — a configuração da aplicação Go continua em backend/.env.
#
# Os valores de MYSQL_ROOT_PASSWORD / RABBITMQ_* aqui devem ser IGUAIS aos
# usados em backend/.env (DB_PASSWORD e RABBIT_URL), já que é o compose quem
# sobe o MySQL e o RabbitMQ com essas credenciais.

# Conta do Docker Hub usada para taguear/puxar as imagens (api, worker-email,
# frontend). Em dev local pode deixar "local".
DOCKERHUB_USERNAME=liedsonlb
IMAGE_TAG=latest

# Precisa bater com DB_PASSWORD em backend/.env
MYSQL_ROOT_PASSWORD=resenha_root
MYSQL_DATABASE=resenha

# Precisam bater com o usuário/senha embutidos em RABBIT_URL em backend/.env
RABBITMQ_DEFAULT_USER=resenha
RABBITMQ_DEFAULT_PASS=resenha_rabbit

# Build args do frontend (Vite) — precisam ser conhecidos em build-time.
# VITE_API_URL=http://api:8080
VITE_API_URL=/api
VITE_APP_KEY=WEBTESTE

TOKEN_KEY=change-me
VERIFICATION_SECRET=w3bl31a

FRONTEND_URL=http://177.136.252.12

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=nao-responder-webleia@uespi.br
MAIL_PASSWORD=zeqbughqqhjonhuk
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=nao-responder-webleia@uespi.br
MAIL_FROM_NAME="Webleia"

# LiveKit — os valores abaixo batem com o devkey de livekit.yaml.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=7xK9mP2qR4sT8vW3yZ5cF6hJ1nL4oB8aD0
