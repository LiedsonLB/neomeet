# syntax=docker/dockerfile:1

# ---------- BUILD ----------
FROM golang:1-alpine AS build

WORKDIR /src

RUN apk add --no-cache git ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/worker-email ./cmd/worker-email

# ---------- RUNTIME ----------
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -H -u 10001 appuser

WORKDIR /app

COPY --from=build /out/worker-email ./worker-email

# IMPORTANTE: internal/service/email_service.go lê os templates em
# "templates/email/<tipo>.html" relativo ao diretório de trabalho (não são
# embutidos via go:embed como as migrations), então essa pasta precisa
# existir dentro da imagem no mesmo caminho relativo usado pelo código.
COPY templates ./templates

RUN chown -R appuser:appuser /app
USER appuser

# Sem servidor HTTP — só consome a fila "webleia.emails" do RabbitMQ.
ENTRYPOINT ["./worker-email"]
